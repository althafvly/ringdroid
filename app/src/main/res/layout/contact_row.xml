<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="?android:attr/selectableItemBackground"
    android:fitsSystemWindows="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- Contact Avatar Chip -->
    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_category_avatar"
        android:contentDescription="@null"
        android:padding="9dp"
        android:src="@drawable/baseline_person_24"
        android:tint="?android:attr/colorAccent" />

    <!-- Contact Display Name -->
    <TextView
        android:id="@+id/row_display_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true"
        android:textColor="#F8FAFC"
        android:textSize="16sp" />

    <!-- Starred Status Icon -->
    <ImageView
        android:id="@+id/row_starred"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/icon_starred"
        android:src="@drawable/baseline_star_24"
        android:tint="#FBBF24" />

    <!-- Custom Ringtone Assigned Indicator -->
    <ImageView
        android:id="@+id/row_ringtone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/icon_ringtone"
        android:src="@drawable/baseline_call_24"
        android:tint="?android:attr/colorAccent" />

</LinearLayout>

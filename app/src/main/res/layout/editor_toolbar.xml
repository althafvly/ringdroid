<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/toolbar_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_toolbar"
    tools:ignore="Overdraw">

    <RelativeLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/btn_back"
            style="@style/ToolbarButton"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/alert_ok_button"
            android:src="@drawable/baseline_arrow_back_24" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_toEndOf="@id/btn_back"
            android:layout_toStartOf="@id/toolbar_actions"
            android:orientation="vertical">

            <TextView
                android:id="@+id/toolbar_title"
                style="@style/ToolbarTitle"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/toolbar_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/toolbar_subtitle_text"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/toolbar_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_amplify"
                style="@style/ToolbarButton"
                android:contentDescription="@string/menu_amplify"
                android:src="@drawable/baseline_volume_up_24" />

            <ImageView
                android:id="@+id/btn_reset"
                style="@style/ToolbarButton"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/menu_reset"
                android:src="@drawable/baseline_restore_24" />

            <ImageView
                android:id="@+id/btn_save"
                style="@style/ToolbarButton"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/save_button"
                android:src="@drawable/baseline_save_24"
                android:tint="@color/waveform_selected" />
        </LinearLayout>
    </RelativeLayout>

    <View
        style="@style/ToolbarDivider"
        android:layout_gravity="bottom" />
</FrameLayout>

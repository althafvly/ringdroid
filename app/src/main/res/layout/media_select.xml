<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Modern App Toolbar -->
    <FrameLayout
        android:id="@+id/toolbar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_toolbar">

        <!-- Normal Toolbar View -->
        <RelativeLayout
            android:id="@+id/toolbar_normal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/toolbar_title"
                style="@style/ToolbarTitle"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="@string/ringdroid_app_name"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btn_search"
                    style="@style/ToolbarButton"
                    android:contentDescription="@string/search_edit_box"
                    android:src="@drawable/baseline_search_24" />

                <ImageView
                    android:id="@+id/btn_record"
                    style="@style/ToolbarButton"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@string/button_start_record_activity"
                    android:src="@drawable/baseline_mic_24" />

                <ImageView
                    android:id="@+id/btn_more"
                    style="@style/ToolbarButton"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@string/button_options"
                    android:src="@drawable/baseline_more_vert_24" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Search Toolbar View -->
        <include
            android:id="@+id/toolbar_search"
            layout="@layout/toolbar_search" />

        <!-- Bottom 1dp Divider -->
        <View
            style="@style/ToolbarDivider"
            android:layout_gravity="bottom" />
    </FrameLayout>

    <!-- Main Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@android:id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@color/list_divider"
            android:dividerHeight="1dp"
            android:fitsSystemWindows="false"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:scrollbarStyle="outsideOverlay" />

        <TextView
            android:id="@+id/empty_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:gravity="center"
            android:text="@string/list_is_empty"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="16sp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>

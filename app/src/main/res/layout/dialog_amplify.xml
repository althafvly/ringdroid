<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Volume Icon Avatar -->
    <ImageView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_category_avatar"
        android:backgroundTint="#1E3A5F"
        android:contentDescription="@string/menu_amplify"
        android:padding="14dp"
        android:src="@drawable/baseline_volume_up_24"
        android:tint="#38BDF8" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/menu_amplify"
        android:textColor="#F8FAFC"
        android:textSize="20sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif"
        android:text="@string/amplify_description"
        android:textColor="#94A3B8"
        android:textSize="13sp" />

    <!-- Big Percentage Display Badge -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_editor_card"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingTop="10dp"
        android:paddingEnd="24dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/amplify_percentage_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="@string/amplify_default_percentage"
            android:textColor="#38BDF8"
            android:textSize="32sp" />
    </LinearLayout>

    <!-- SeekBar -->
    <SeekBar
        android:id="@+id/amplify_seekbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:contentDescription="@string/menu_amplify"
        android:max="400"
        android:progress="100"
        android:progressBackgroundTint="#334155"
        android:progressTint="#38BDF8"
        android:thumbTint="#38BDF8" />

    <!-- Range markers beneath seekbar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/amplify_minimum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="@string/amplify_min_percentage"
            android:textColor="#64748B"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_toEndOf="@id/amplify_minimum"
            android:layout_toStartOf="@id/amplify_maximum"
            android:gravity="center"
            android:text="@string/amplify_normal_percentage"
            android:textColor="#64748B"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/amplify_maximum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="@string/amplify_max_percentage"
            android:textColor="#64748B"
            android:textSize="11sp" />
    </RelativeLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/btn_secondary"
            android:contentDescription="@string/delete_cancel_button"
            android:fontFamily="sans-serif-medium"
            android:text="@string/delete_cancel_button"
            android:textAllCaps="false"
            android:textColor="#94A3B8"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_apply"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/btn_primary"
            android:contentDescription="@string/alert_ok_button"
            android:fontFamily="sans-serif-medium"
            android:text="@string/alert_ok_button"
            android:textAllCaps="false"
            android:textColor="#0F172A"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>


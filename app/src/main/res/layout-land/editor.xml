<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_background"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.ringdroid.WaveformView
            android:id="@+id/waveform"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.ringdroid.MarkerView
            android:id="@+id/startmarker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/start_marker"
            android:src="@drawable/marker_left" />

        <com.ringdroid.MarkerView
            android:id="@+id/endmarker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/end_marker"
            android:src="@drawable/marker_right" />

    </RelativeLayout>

    <TextView
        android:id="@+id/info"
        style="@style/AudioFileInfoOverlayText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/window_background"
        android:gravity="center"
        android:minHeight="24dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface_toolbar"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Start Pill -->
        <LinearLayout
            android:layout_width="136dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_editor_card"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/mark_start"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="4dp"
                android:text="@string/start_label"
                android:textAllCaps="false"
                android:textColor="?android:attr/colorAccent"
                android:textSize="13sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:background="#334155" />

            <EditText
                android:id="@+id/starttext"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:inputType="number|numberDecimal"
                android:paddingStart="4dp"
                android:paddingEnd="6dp"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Transport Controls -->
        <ImageButton
            android:id="@+id/zoom_out"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/btn_circle_secondary"
            android:contentDescription="@string/zoom_out"
            android:padding="8dp"
            android:src="@drawable/baseline_zoom_out_24"
            android:tint="#94A3B8" />

        <ImageButton
            android:id="@+id/rew"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/btn_circle_secondary"
            android:contentDescription="@string/rewind"
            android:padding="10dp"
            android:src="@drawable/baseline_fast_rewind_24"
            android:tint="#F8FAFC" />

        <ImageButton
            android:id="@+id/play"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/btn_circle_primary"
            android:contentDescription="@string/play"
            android:elevation="4dp"
            android:padding="12dp"
            android:src="@drawable/baseline_play_arrow_24"
            android:tint="#0F172A" />

        <ImageButton
            android:id="@+id/ffwd"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/btn_circle_secondary"
            android:contentDescription="@string/ffwd"
            android:padding="10dp"
            android:src="@drawable/baseline_fast_forward_24"
            android:tint="#F8FAFC" />

        <ImageButton
            android:id="@+id/zoom_in"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/btn_circle_secondary"
            android:contentDescription="@string/zoom_in"
            android:padding="8dp"
            android:src="@drawable/baseline_zoom_in_24"
            android:tint="#94A3B8" />

        <!-- End Pill -->
        <LinearLayout
            android:layout_width="136dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_editor_card"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/mark_end"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="4dp"
                android:text="@string/end_label"
                android:textAllCaps="false"
                android:textColor="?android:attr/colorAccent"
                android:textSize="13sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:background="#334155" />

            <EditText
                android:id="@+id/endtext"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:inputType="number|numberDecimal"
                android:paddingStart="4dp"
                android:paddingEnd="6dp"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
